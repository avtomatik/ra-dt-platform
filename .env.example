###############################################################################
# Transport
###############################################################################
RADP_TRANSPORT__MODE=http
RADP_TRANSPORT__CURL_PATH=/opt/product/bin/amd64/curl
RADP_TRANSPORT__CERT_THUMBPRINT=00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff
###############################################################################
# Remote RA
###############################################################################
RADP_REMOTE_RA__BASE_URL=http://emulator:8000/api/ra/
# Folder names are configured ONLY in config/certificate-folders.toml.
# Copy config/certificate-folders.toml.example before starting RADP.
# To use a nonstandard file location, you may set the path (not folder names):
# RADP_REMOTE_RA__CERTIFICATE_FOLDERS_FILE=/app/config/certificate-folders.toml
###############################################################################
# Database
###############################################################################
RADP_DATABASE__HOST=postgres
RADP_DATABASE__PORT=5432
RADP_DATABASE__DATABASE=radp
RADP_DATABASE__USERNAME=radp
RADP_DATABASE__PASSWORD=change-me
###############################################################################
# Reporting (optional; defaults to the full RADP inventory column set)
###############################################################################
# RADP_REPORTING__PROJECTION_FIELDS=gid,common_name,serial_number,status,not_after
