# Test/local mode: no static RA host override.
# Copy this file to .env.compose and customize it alongside .env.
COMPOSE_PROJECT_NAME=radp
DEPLOY_ENVIRONMENT=test

###############################################################################
# Docker image sources
###############################################################################
DEPLOY_OFELIA_IMAGE=mcuadros/ofelia:latest
DEPLOY_POSTGRES_IMAGE=postgres:17
DEPLOY_PYTHON_BASE_IMAGE=python:3.14-slim
DEPLOY_RADP_IMAGE=
###############################################################################
# Network proxy (leave empty if unused)
###############################################################################
DEPLOY_HTTP_PROXY=
DEPLOY_HTTPS_PROXY=
DEPLOY_NO_PROXY=localhost,127.0.0.1,postgres,db-init,platform
###############################################################################
# Expected identity — must match Kaniko build arguments
###############################################################################
DEPLOY_CONTAINER_GID=1000
DEPLOY_CONTAINER_UID=1000
DEPLOY_CONTAINER_USER=radp
###############################################################################
# Preserve existing shared network for emulator connectivity
###############################################################################
DEPLOY_RA_NETWORK=ra-network

# Required only for DEPLOY_ENVIRONMENT=production:
# DEPLOY_RA_HOST_IP=127.1.1.1
# The host alias is taken from RADP_REMOTE_RA__BASE_URL in .env.
